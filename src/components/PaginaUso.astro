---
import Base from '../layouts/Base.astro'
import HeroFoto from './HeroFoto.astro'
import Faq from './Faq.astro'
import CtaFinal from './CtaFinal.astro'
import type { Imagen } from '../data/imagenes'
import type { Pregunta } from '../data/faq'

interface Props {
  tituloSeo: string
  descripcion: string
  miga: string
  h1: string
  entradilla: string
  /** Identificador para la medición (uso_<uso>). */
  uso: 'jardin' | 'terraza' | 'patio' | 'piscina' | 'palma'
  /** Foto de cabecera: solo se muestra si su licencia está verificada. */
  foto?: Imagen
  encuadre?: string
  /** Lo que necesitamos saber para presupuestar este tipo de espacio. */
  necesitamos: string[]
  claves: { titulo: string; texto: string }[]
  preguntas: Pregunta[]
}
const { tituloSeo, descripcion, miga, h1, entradilla, uso, foto, encuadre, necesitamos, claves, preguntas } = Astro.props
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
}
---
<Base titulo={tituloSeo} descripcion={descripcion} migas={[{ nombre: miga, url: Astro.url.pathname }]} jsonLd={[faqLd]} cabeceraTransparente>
  <HeroFoto img={foto} titulo={h1} encuadre={encuadre} alto="medio">
    <p>{entradilla}</p>
    <div class="botones">
      <a class="boton boton--blanco" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion={`uso_${uso}`}>Pedir presupuesto</a>
    </div>
  </HeroFoto>

  <section class="seccion">
    <div class="contenedor dos">
      <h2>Lo que conviene saber</h2>
      <ol class="claves">
        {claves.map((c, i) => <li data-aparece><span>{i + 1}</span><div><h3>{c.titulo}</h3><p>{c.texto}</p></div></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion seccion--gris">
    <div class="contenedor dos">
      <div class="prosa contenido"><slot /></div>
      <aside class="necesitamos">
        <h2>Para tu presupuesto</h2>
        <ul>{necesitamos.map((n) => <li>{n}</li>)}</ul>
        <a class="boton boton--oscuro" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion={`uso_${uso}_lista`}>Pedir presupuesto</a>
      </aside>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor dos">
      <h2>Dudas habituales</h2>
      <Faq preguntas={preguntas} />
    </div>
  </section>

  <CtaFinal ubicacion={`cta_uso_${uso}`} />
</Base>
<style>
  .dos { display: grid; gap: clamp(20px, 4vw, 64px); align-items: start; }
  @media (min-width: 960px) { .dos { grid-template-columns: 0.8fr 1.2fr; } }
  .claves { list-style: none; margin: 0; padding: 0; display: grid; }
  .claves li { display: grid; grid-template-columns: 56px 1fr; gap: 12px; padding: 26px 0; border-top: 1px solid var(--borde); }
  .claves li:last-child { border-bottom: 1px solid var(--borde); }
  .claves span { font: 600 2rem/1 var(--titular); color: var(--verde); }
  .claves h3 { margin-bottom: 0.3em; }
  .claves p { margin: 0; color: var(--texto-2); }
  .contenido :global(h2:first-child) { margin-top: 0; }
  .necesitamos { background: #fff; padding: clamp(24px, 3vw, 36px); }
  .necesitamos h2 { font-size: clamp(1.5rem, 2.2vw, 1.9rem); }
  .necesitamos ul { margin: 0 0 24px; padding-left: 1.1em; display: grid; gap: 8px; color: var(--texto-2); }
  @media (min-width: 960px) { .necesitamos { order: -1; position: sticky; top: 100px; } }
</style>
