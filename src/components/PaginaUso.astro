---
import Base from '../layouts/Base.astro'
import Foto from './Foto.astro'
import Faq from './Faq.astro'
import CtaFinal from './CtaFinal.astro'
import { publicable, type Imagen } from '../data/imagenes'
import type { Pregunta } from '../data/faq'

interface Props {
  tituloSeo: string
  descripcion: string
  miga: string
  h1: string
  entradilla: string
  /** Identificador para la medición (uso_<uso>). */
  uso: 'jardin' | 'terraza' | 'patio' | 'piscina' | 'palma'
  /** Foto de cabecera: solo se muestra si su licencia está verificada. */
  foto?: Imagen
  encuadre?: string
  /** Lo que necesitamos saber para presupuestar este tipo de espacio. */
  necesitamos: string[]
  claves: { titulo: string; texto: string }[]
  preguntas: Pregunta[]
}
const { tituloSeo, descripcion, miga, h1, entradilla, uso, foto, encuadre, necesitamos, claves, preguntas } = Astro.props
const conFoto = !!foto && publicable(foto)
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
}
---
<Base titulo={tituloSeo} descripcion={descripcion} migas={[{ nombre: miga, url: Astro.url.pathname }]} jsonLd={[faqLd]}>
  <section class="cabecera-uso">
    <div class="contenedor cabecera-uso__rejilla">
      <div>
        <h1>{h1}</h1>
        <p class="entradilla">{entradilla}</p>
        <div class="botones">
          <a class="boton boton--principal" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion={`uso_${uso}`}>Pedir presupuesto</a>
          <a class="boton boton--claro" href="/como-elegir-cesped-artificial/">Cómo elegir el césped</a>
        </div>
      </div>
      {conFoto ? (
        <div class="cabecera-uso__foto"><Foto img={foto!} sizes="(min-width: 980px) 45vw, 100vw" prioridad encuadre={encuadre} /></div>
      ) : (
        <aside class="cabecera-uso__caja">
          <h2>Para presupuestar necesitamos</h2>
          <ul class="lista-check">{necesitamos.map((n) => <li>{n}</li>)}</ul>
          <a href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion={`uso_${uso}_caja`}>Rellenar el formulario →</a>
        </aside>
      )}
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="cabeza"><span class="etiqueta">Lo que conviene saber</span><h2>Antes de decidir</h2></div>
      <ol class="claves">
        {claves.map((c, i) => <li data-aparece><span class="claves__n">{String(i + 1).padStart(2, '0')}</span><h3>{c.titulo}</h3><p>{c.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="seccion seccion--gris">
    <div class="contenedor prosa">
      <slot />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor faq-uso">
      <div><span class="etiqueta">Preguntas frecuentes</span><h2>Dudas habituales</h2></div>
      <Faq preguntas={preguntas} />
    </div>
  </section>

  <CtaFinal ubicacion={`cta_uso_${uso}`} />
</Base>
<style>
  .cabecera-uso { background: var(--verde); color: #fff; padding-block: clamp(40px, 6vw, 72px); }
  .cabecera-uso__rejilla { display: grid; gap: clamp(28px, 5vw, 56px); align-items: center; }
  @media (min-width: 980px) { .cabecera-uso__rejilla { grid-template-columns: 1.2fr 0.8fr; } }
  .cabecera-uso h1 { color: #fff; }
  .cabecera-uso .entradilla { color: #d3e5dc; margin-bottom: 26px; }
  .cabecera-uso__foto { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; }
  .cabecera-uso__caja { background: #fff; color: var(--texto); border-radius: var(--radio); padding: clamp(22px, 3vw, 30px); }
  .cabecera-uso__caja h2 { font-size: 1.2rem; }
  .cabecera-uso__caja a { font-weight: 700; }

  .claves { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .claves li { padding: 24px; border: 1px solid var(--borde); border-radius: var(--radio); }
  .claves__n { display: block; font-weight: 800; color: var(--cesped-2); margin-bottom: 10px; }
  .claves p { margin: 0; color: var(--texto-2); font-size: 15.5px; }

  .faq-uso { display: grid; gap: clamp(20px, 4vw, 56px); }
  @media (min-width: 980px) { .faq-uso { grid-template-columns: 0.7fr 1.3fr; } }
</style>
