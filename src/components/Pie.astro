---
import Logo from './Logo.astro'
import { negocio, telHref, waHref } from '../config/negocio'
const { telefono, whatsapp, email } = negocio.contacto
const grupos = [
 { nombre:'Información', enlaces:[['/instalacion/','Instalación'],['/como-elegir-cesped-artificial/','Cómo elegir el césped'],['/ventajas-y-mantenimiento/','Mantenimiento'],['/preguntas-frecuentes/','Preguntas frecuentes'],['/contacto/','Contacto']] },
 { nombre:'Aplicaciones', enlaces:[['/cesped-artificial-para-jardines/','Jardines'],['/cesped-artificial-para-terrazas/','Terrazas'],['/cesped-artificial-para-piscinas/','Piscinas'],['/cesped-artificial-para-patios/','Patios']] },
 { nombre:'Zona de servicio', enlaces:[['/cesped-artificial-palma/','Palma'],['/contacto/','Consultar otra zona de Mallorca']] },
]
---
<footer class="pie"><div class="contenedor">
 <div class="pie__principal"><div><a href="/" class="pie__logo" aria-label="Universal Grass, inicio"><Logo alto={28}/></a><p>Santa Ponsa · Mallorca</p></div><div class="pie__contacto">{whatsapp && <a href={waHref(whatsapp)} target="_blank" rel="noopener">WhatsApp · 630 45 56 07</a>}{telefono && <a href={telHref(telefono)}>{telefono}</a>}{email && <a href={`mailto:${email}`}>{email}</a>}</div></div>
 <nav class="pie__grupos" aria-label="Navegación del pie">{grupos.map(g=><details open data-pie-grupo><summary>{g.nombre}<span aria-hidden="true">+</span></summary><ul>{g.enlaces.map(([url,texto])=><li><a href={url}>{texto}</a></li>)}</ul></details>)}</nav>
 <div class="pie__legal"><p>by Universal Nautic<br /><small>© {new Date().getFullYear()} {negocio.titular.razonSocial}<br />Fotografías de ambiente: Pexels.</small></p><nav aria-label="Información legal"><a href="/aviso-legal/">Aviso legal</a><a href="/politica-de-privacidad/">Privacidad</a><a href="/politica-de-cookies/">Cookies</a></nav></div>
</div></footer>
<script>
const media=matchMedia('(min-width: 800px)')
const ajustar=()=>document.querySelectorAll<HTMLDetailsElement>('[data-pie-grupo]').forEach(d=>{d.open=media.matches})
ajustar();media.addEventListener('change',ajustar)
</script>
<style>
.pie { background:var(--oscuro); color:#e6ece6; padding-block:36px 28px; font-size:14px; }
.pie a { color:inherit; text-decoration:none; } .pie a:hover { text-decoration:underline; }
.pie__principal { display:flex; justify-content:space-between; gap:24px; padding-bottom:28px; }
.pie__logo { display:inline-block; } .pie__principal p { margin:12px 0 0; font-size:13px; }
.pie__contacto { display:flex; flex-direction:column; gap:12px; }
.pie__grupos { display:grid; grid-template-columns:repeat(3,1fr); gap:32px; border-top:1px solid #ffffff25; padding-top:24px; }
summary { cursor:pointer; display:flex; justify-content:space-between; gap:24px; list-style:none; font-weight:600; padding-block:12px; }
summary::-webkit-details-marker { display:none; }
summary span { display:none; font-size:18px; font-weight:400; }
ul { list-style:none; display:grid; gap:12px; margin:12px 0 20px; padding:0; }
.pie__legal { display:flex; justify-content:space-between; gap:24px; border-top:1px solid #ffffff25; padding-top:24px; margin-top:24px; }
.pie__legal p { margin:0; font-size:13px; line-height:1.7; }
.pie__legal small { color:#c4cec3; font-size:12px; }
.pie__legal nav { display:flex; flex-wrap:wrap; gap:20px; align-content:start; font-size:12px; }
@media(max-width:799px) { .pie__principal { flex-direction:column; gap:20px; } .pie__grupos { display:block; padding:0; } details { border-bottom:1px solid #ffffff25; } summary { padding-block:16px; } summary span { display:inline; } details[open] summary span { transform:rotate(45deg); } .pie__legal { flex-direction:column; } }
</style>

<style>.pie__logo { --logo-blanco:1; }</style>
