---
// Cabecera común de las páginas interiores: título y entradilla sobre verde.
interface Props { titulo: string; etiqueta?: string }
const { titulo, etiqueta } = Astro.props
---
<section class="cabecera-pagina">
  <div class="contenedor">
    {etiqueta && <span class="etiqueta">{etiqueta}</span>}
    <h1>{titulo}</h1>
    {Astro.slots.has('default') && <p class="entradilla"><slot /></p>}
  </div>
</section>
<style>
  .cabecera-pagina { background: var(--verde); color: #fff; padding-block: clamp(36px, 5vw, 60px); }
  .cabecera-pagina .etiqueta { color: #9fdc96; }
  .cabecera-pagina h1 { color: #fff; max-width: 22ch; }
  .cabecera-pagina .entradilla { color: #d3e5dc; margin: 0; }
  .cabecera-pagina .entradilla :global(a) { color: #fff; }
</style>
