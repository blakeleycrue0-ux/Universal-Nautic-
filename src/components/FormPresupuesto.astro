---
/**
 * Formulario de presupuesto — Netlify Forms.
 * Solicitud inicial: localidad, superficie, contacto y una foto opcional.
 * Envío HTML normal sin JavaScript; con JS añade validación, reducción
 * de fotografías, origen de la visita y gestión de errores.
 */
import { municipiosMallorca } from '../config/negocio'
---
<form
  class="form"
  name="presupuesto"
  method="POST"
  action="/presupuesto/gracias/"
  enctype="multipart/form-data"
  data-netlify="true"
  netlify-honeypot="campo-bot"
  data-form-presupuesto
>
  <input type="hidden" name="form-name" value="presupuesto" />
  <p class="visually-hidden"><label>No rellenes este campo: <input name="campo-bot" tabindex="-1" autocomplete="off" /></label></p>
  <input type="hidden" name="origen" value="" data-origen />
  <input type="hidden" name="pagina" value="" data-pagina />

  <div class="campo"><label for="f-municipio">Localidad</label><select id="f-municipio" name="municipio" required><option value="">Elige tu localidad</option>{municipiosMallorca.map(m=><option value={m}>{m}</option>)}<option value="Fuera de Mallorca">Fuera de Mallorca</option></select><p class="campo__error" aria-live="polite"></p></div>
  <div class="campo"><label for="f-m2">Superficie aproximada (m²)</label><input id="f-m2" name="metros_cuadrados" type="number" inputmode="decimal" min="1" max="100000" step="any" required placeholder="Por ejemplo, 30"/><p class="campo__error" aria-live="polite"></p></div>
  <div class="campo"><label for="f-contacto">Teléfono o correo electrónico</label><input id="f-contacto" name="contacto" required autocomplete="off" placeholder="Cómo podemos contactarte"/><p class="campo__error" aria-live="polite"></p></div>
  <div class="campo"><label for="f-foto">Foto del espacio <span class="opcional">(opcional)</span></label><input id="f-foto" type="file" name="foto_1" accept="image/jpeg,image/png,image/webp" data-foto/><p class="campo__ayuda">JPG, PNG o WebP. Máximo 8 MB.</p><span data-foto-vista class="vista-foto" hidden></span><p class="campo__error" aria-live="polite"></p></div>
  <input type="hidden" name="modelo" data-modelo/>
  <input type="hidden" name="email"/>
  <input type="hidden" name="telefono"/>
  <div class="campo"><label class="check"><input type="checkbox" name="acepta_privacidad" value="si" required/><span>He leído la <a href="/politica-de-privacidad/">política de privacidad</a> y acepto el uso de mis datos para responder a esta solicitud.</span></label><p class="campo__error" aria-live="polite"></p></div>

  <div class="form__envio">
    <button class="boton boton--oscuro" type="submit" data-enviar>Enviar solicitud</button>
    <p class="form__estado" role="status" aria-live="polite" data-estado></p>
  </div>
</form>

<script>
  import { track } from '../lib/analitica'

  const form = document.querySelector<HTMLFormElement>('[data-form-presupuesto]')
  if (form) {
    form.noValidate = true
    const contacto = form.querySelector<HTMLInputElement>("#f-contacto")!
    const validarContacto = () => {
      const valor = contacto.value.trim()
      const correcto = valor.includes("@") ? /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(valor) : /^[+\d ()-]+$/.test(valor) && valor.replace(/\D/g, "").length >= 9 && valor.replace(/\D/g, "").length <= 15
      contacto.setCustomValidity(valor && !correcto ? "Indica un teléfono o correo electrónico válido." : "")
    }
    contacto.addEventListener("input", validarContacto)
    // Origen de la visita (UTM o web de procedencia), guardado durante la sesión.
    try {
      const p = new URLSearchParams(location.search)
      const utm = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => p.get(k)).filter(Boolean).join(' / ')
      if (utm) sessionStorage.setItem('un-origen', utm)
      if (!sessionStorage.getItem('un-origen') && document.referrer && !document.referrer.includes(location.host))
        sessionStorage.setItem('un-origen', new URL(document.referrer).hostname)
      form.querySelector<HTMLInputElement>('[data-origen]')!.value = sessionStorage.getItem('un-origen') || 'directo'
      form.querySelector<HTMLInputElement>('[data-pagina]')!.value = sessionStorage.getItem('un-entrada') || location.pathname
    } catch { /* sin sessionStorage */ }

    // Si viene de una ficha de producto, se anota el modelo en el mensaje.
    const modelo = new URLSearchParams(location.search).get('modelo')
    if (modelo) form.querySelector<HTMLInputElement>('[data-modelo]')!.value = modelo

    let iniciado = false
    form.addEventListener('input', () => {
      if (!iniciado) { iniciado = true; track('formulario_inicio') }
    })

    // Validate attachments before encoding and release temporary previews.
    let fotoUrl: string | null = null
    form.querySelectorAll<HTMLInputElement>('[data-foto]').forEach((input) => {
      input.addEventListener('change', () => {
        const vista = form.querySelector<HTMLElement>('[data-foto-vista]')!
        if (fotoUrl) URL.revokeObjectURL(fotoUrl)
        fotoUrl = null
        const f = input.files?.[0]
        const error = f && (!['image/jpeg', 'image/png', 'image/webp'].includes(f.type) || f.size > 8_000_000)
        input.setCustomValidity(error ? 'Selecciona un JPG, PNG o WebP de hasta 8 MB.' : '')
        vista.hidden = !f || !!error
        if (f && !error) { fotoUrl = URL.createObjectURL(f); vista.style.backgroundImage = `url(${fotoUrl})` }
      })
    })

    const mensaje = (el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      const v = el.validity
      if (v.valueMissing) return el.type === 'checkbox' ? 'Necesitamos tu consentimiento para responderte.' : 'Este campo es obligatorio.'
      if (v.typeMismatch && el.type === 'email') return 'Revisa el email.'
      if (v.patternMismatch) return 'Revisa el teléfono (mínimo 9 dígitos).'
      if (v.rangeUnderflow || v.rangeOverflow) return 'Indica una superficie válida.'
      return el.validationMessage
    }
    const validar = () => {
      validarContacto()
      let primero: HTMLElement | null = null
      form.querySelectorAll<HTMLElement>('.campo').forEach((campo) => {
        const els = [...campo.querySelectorAll<HTMLInputElement>('input, select, textarea')].filter((e) => e.willValidate)
        const malo = els.find((e) => !e.checkValidity())
        const err = campo.querySelector('.campo__error')
        els.forEach((e) => e.setAttribute('aria-invalid', String(e === malo)))
        if (err) err.textContent = malo ? mensaje(malo) : ''
        if (malo && !primero) primero = malo
      })
      ;(primero as HTMLElement | null)?.focus()
      return !primero
    }

    // Reduce cada foto a 1600 px como máximo (JPEG) para no superar los 8 MB por envío.
    const reducir = async (f: File): Promise<File> => {
      if (!f.type.startsWith('image/') || f.size < 600_000) return f
      try {
        const bmp = await createImageBitmap(f)
        const k = Math.min(1, 1600 / Math.max(bmp.width, bmp.height))
        const c = document.createElement('canvas')
        c.width = Math.round(bmp.width * k)
        c.height = Math.round(bmp.height * k)
        c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height)
        const blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', 0.82))
        return blob ? new File([blob], f.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : f
      } catch {
        return f
      }
    }

    const estado = form.querySelector<HTMLElement>('[data-estado]')!
    const boton = form.querySelector<HTMLButtonElement>('[data-enviar]')!
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!validar()) return
      boton.disabled = true
      estado.textContent = 'Enviando…'
      try {
        const datos = new FormData(form)
        if (contacto.value.includes("@")) datos.set("email", contacto.value.trim())
        else datos.set("telefono", contacto.value.trim())
        for (const n of [1, 2, 3]) {
          const f = datos.get(`foto_${n}`)
          if (f instanceof File && f.size) datos.set(`foto_${n}`, await reducir(f))
          else datos.delete(`foto_${n}`)
        }
        const r = await fetch('/', { method: 'POST', body: datos })
        if (!r.ok) throw new Error(String(r.status))
        try { sessionStorage.setItem('un-lead', 'presupuesto') } catch { /* */ }
        location.href = '/presupuesto/gracias/'
      } catch {
        boton.disabled = false
        estado.textContent = 'No hemos podido enviar la solicitud. Inténtalo de nuevo en unos minutos o contacta con nosotros por teléfono.'
      }
    })
  }
</script>

<style>
  .form { display: grid; gap: 20px; }
  fieldset { border: 1px solid var(--borde); margin: 0; padding: clamp(20px, 3vw, 30px); background: #fff; border-radius: var(--radio); display: grid; gap: 18px; }
  legend { float: left; width: 100%; display: flex; align-items: center; gap: 12px; margin-bottom: 4px; font: 750 1.2rem/1.2 var(--sans); }
  legend + * { clear: both; }
  .form__paso { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--verde); color: #fff; font: 700 14px/1 var(--sans); }
  .opcional { font: 500 14px var(--sans); color: var(--texto-2); }
  .form__fila { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .campo { display: grid; gap: 6px; align-content: start; }
  label, .campo__titulo { font-weight: 650; font-size: 15px; }
  input:not([type='radio'], [type='checkbox'], [type='file']), select, textarea {
    width: 100%; min-height: 50px; padding: 12px 14px; border: 1px solid #b9c4be; border-radius: var(--radio);
    background: #fff; font: 400 16px/1.4 var(--sans); color: var(--texto);
  }
  textarea { min-height: 110px; resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--verde-vivo); outline-offset: 0; border-color: var(--verde); }
  [aria-invalid='true'] { border-color: var(--error) !important; background: #fff6f5 !important; }
  .campo__ayuda { margin: 0; font-size: 14px; color: var(--texto-2); }
  .campo__error { margin: 0; font-size: 14px; font-weight: 650; color: var(--error); }
  .campo__error:empty { display: none; }
  .opciones { display: flex; flex-wrap: wrap; gap: 8px; }
  .opcion { position: relative; }
  .opcion input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .opcion span { display: inline-block; padding: 11px 16px; border-radius: var(--radio); border: 1px solid #b9c4be; background: #fff; font-weight: 600; cursor: pointer; transition: background 0.15s, border-color 0.15s; }
  .opcion span:hover { border-color: var(--verde); }
  .opcion input:checked + span { background: var(--verde); border-color: var(--verde); color: #fff; }
  .opcion input:focus-visible + span { outline: 3px solid var(--verde-vivo); outline-offset: 2px; }
  .fotos { display: grid; gap: 12px; grid-template-columns: repeat(3, 1fr); }
  .foto { position: relative; display: block; cursor: pointer; }
  .foto input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .foto__caja {
    display: grid; place-items: center; aspect-ratio: 1; border-radius: var(--radio); border: 2px dashed #b9c4be; background: var(--gris-50) center/cover;
    font-size: 14px; font-weight: 600; color: var(--texto-2); text-align: center; padding: 8px;
  }
  .foto:hover .foto__caja { border-color: var(--verde); }
  .foto__caja.con-foto { border-style: solid; border-color: var(--verde); }
  .foto__caja.con-foto span { display: none; }
  .foto input:focus-visible + .foto__caja { outline: 3px solid var(--verde-vivo); outline-offset: 2px; }
  .check { display: flex; gap: 12px; align-items: flex-start; font-weight: 500; }
  .check input { width: 22px; height: 22px; flex: none; margin-top: 2px; accent-color: var(--verde); }
  .form__envio { display: grid; gap: 12px; justify-items: start; }
  .form__envio .boton { min-width: 260px; }
  .form__envio .boton[disabled] { opacity: 0.6; cursor: wait; }
  .form__estado { margin: 0; font-weight: 650; }
</style>

<style>
.form { gap:22px; }
.vista-foto { display:block; width:100%; height:180px; background:center/contain no-repeat; }
.vista-foto[hidden] { display:none; }
input[type=file] { width:100%; font:400 14px/1.5 var(--sans); }
input[type=file]::file-selector-button { padding:10px 16px; margin-right:12px; border:1px solid var(--borde); background:#fff; font:inherit; cursor:pointer; }
.form__envio .boton { min-width:0; }
</style>
