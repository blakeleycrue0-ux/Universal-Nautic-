---
import { negocio, waHref } from '../config/negocio'
const { whatsapp } = negocio.contacto
---
{whatsapp && (
  <a class="whatsapp" href={waHref(whatsapp)} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp al 630 45 56 07">
    <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M20.52 3.48A11.85 11.85 0 0 0 12.05 0C5.47 0 .11 5.35.1 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.26-1.64a11.96 11.96 0 0 0 5.78 1.47h.01c6.58 0 11.94-5.35 11.95-11.93a11.86 11.86 0 0 0-3.48-8.42Zm-8.47 18.34a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.72.97.99-3.63-.24-.37a9.87 9.87 0 0 1-1.52-5.27c0-5.47 4.45-9.92 9.93-9.92a9.86 9.86 0 0 1 7.02 2.91 9.86 9.86 0 0 1 2.91 7.02c0 5.48-4.46 9.93-9.96 9.88Zm5.45-7.43c-.3-.15-1.76-.87-2.03-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.9-.8-1.5-1.78-1.67-2.08-.18-.3-.02-.46.13-.61.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.63-.93-2.23-.24-.58-.49-.5-.68-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.5s1.07 2.92 1.22 3.12c.15.2 2.1 3.21 5.08 4.5.71.3 1.27.49 1.7.62.71.22 1.36.19 1.87.11.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
    </svg>
  </a>
)}
<style>
.whatsapp { position:fixed; z-index:45; right:20px; bottom:calc(20px + env(safe-area-inset-bottom)); display:grid; place-items:center; width:58px; height:58px; background:#25d366; color:#fff; border-radius:50%; text-decoration:none; box-shadow:0 3px 12px #0003; }
.whatsapp:hover { background:#1eb45a; color:#fff; }
.whatsapp:focus-visible { outline:3px solid #173a2c; outline-offset:4px; }
@media(max-width:600px) { .whatsapp { right:16px; bottom:calc(16px + env(safe-area-inset-bottom)); } }
</style>
