---
/**
 * Cabecera con fotografía a sangre: el texto va sobre la imagen, abajo a la
 * izquierda, con un sombreado suave solo donde hace falta para leerlo.
 * Si la foto no tiene licencia verificada, se muestra sobre fondo oscuro.
 */
import Foto from './Foto.astro'
import { publicable, type Imagen } from '../data/imagenes'
interface Props {
  img?: Imagen
  titulo: string
  encuadre?: string
  alto?: 'completo' | 'medio'
}
const { img, titulo, encuadre = '50% 50%', alto = 'completo' } = Astro.props
const conFoto = !!img && publicable(img)
---
<section class:list={['hero', `hero--${alto}`, { 'hero--foto': conFoto }]}>
  {conFoto && <div class="hero__imagen"><Foto img={img!} sizes="100vw" prioridad encuadre={encuadre} /></div>}
  <div class="contenedor hero__texto">
    <h1>{titulo}</h1>
    <slot />
  </div>
</section>
<style>
  .hero { position: relative; display: flex; align-items: flex-end; background: var(--oscuro); color: #fff; overflow: hidden; }
  .hero--completo { min-height: max(560px, 92svh); }
  .hero--medio { min-height: max(460px, 72svh); }
  .hero__imagen { position: absolute; inset: 0; }
  .hero--foto .hero__imagen :global(figcaption) { z-index: 2; }
  .hero__imagen :global(img) { transform: scale(1.02); }
  /* sombreado desde abajo a la izquierda: deja limpia la parte alta y derecha de la foto */
  .hero--foto::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to top, rgb(8 14 11 / 0.7) 0%, rgb(8 14 11 / 0.25) 34%, rgb(8 14 11 / 0) 55%),
      linear-gradient(to right, rgb(8 14 11 / 0.32) 0%, rgb(8 14 11 / 0) 50%);
  }
  .hero__texto { position: relative; z-index: 1; padding-block: 140px clamp(48px, 8vh, 88px); }
  .hero h1 { color: #fff; max-width: 12ch; margin-bottom: 0.3em; text-wrap: balance; }
  .hero--medio h1 { font-size: clamp(2.3rem, 5vw, 4.2rem); max-width: 16ch; }
  .hero :global(p) { max-width: 40ch; font-size: clamp(1.08rem, 1.6vw, 1.3rem); line-height: 1.5; color: rgb(255 255 255 / 0.9); margin-bottom: 28px; }
  .hero :global(.enlace-flecha) { color: #fff; }
  /* la etiqueta «Imagen de referencia» de las fotos de stock queda arriba a la derecha, discreta */
  .hero :global(.foto figcaption) { right: var(--margen); bottom: 16px; z-index: 2; }
  @media (max-width: 700px) {
    .hero--completo { min-height: max(520px, 86svh); }
    .hero--foto::after { background: linear-gradient(to top, rgb(8 14 11 / 0.85) 0%, rgb(8 14 11 / 0.45) 45%, rgb(8 14 11 / 0.05) 75%); }
  }
</style>
