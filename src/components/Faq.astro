---
import type { Pregunta } from '../data/faq'
interface Props { preguntas: Pregunta[] }
const { preguntas } = Astro.props
---
<div class="faq">
  {preguntas.map((q) => (
    <details>
      <summary><h3>{q.p}</h3></summary>
      <p>{q.r}</p>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--borde); }
  details { border-bottom: 1px solid var(--borde); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 18px 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.15rem; }
  summary:hover h3 { color: var(--verde); }
  summary::after { content: '+'; flex: none; font: 400 1.6rem/1 var(--titular); color: var(--verde); transition: transform 0.25s var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding: 0 44px 20px 0; color: var(--texto-2); max-width: 72ch; }
</style>
