---
import { negocio, waHref } from '../config/negocio'
interface Props { titulo?: string; texto?: string; ubicacion?: string }
const {
  titulo = 'Consulta por WhatsApp',
  texto = 'Dinos el municipio y las medidas aproximadas. Puedes enviarnos fotos del espacio al 630 45 56 07.',
  ubicacion = 'cta_final',
} = Astro.props
const { whatsapp } = negocio.contacto
---
<section class="seccion cierre">
  <div class="contenedor cierre__fila">
    <div>
      <h2>{titulo}</h2>
      <p class="entradilla">{texto}</p>
    </div>
    <div class="cierre__acciones">
      {whatsapp && <a class="boton boton--whatsapp" href={waHref(whatsapp)} target="_blank" rel="noopener" data-ubicacion={ubicacion}>WhatsApp · 630 45 56 07</a>}
    </div>
  </div>
</section>
<style>
  .cierre__fila { display: grid; gap: 32px; align-items: end; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .cierre { padding-block:48px 88px; border-top:1px solid var(--borde); }
  .cierre h2 { color: var(--texto); font-size:clamp(1.5rem,3vw,2rem); }
  .cierre .entradilla { margin: 0; }
  .cierre__acciones { display: grid; gap: 18px; justify-items: start; }
  @media (min-width: 900px) { .cierre__acciones { justify-items: end; text-align: right; } }
  .cierre__tel { font: 600 clamp(1.6rem, 2.6vw, 2.2rem)/1 var(--titular); text-decoration: none; }
</style>
