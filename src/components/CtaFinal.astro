---
import { negocio, telHref, waHref } from '../config/negocio'
interface Props { titulo?: string; texto?: string; ubicacion?: string }
const {
  titulo = '¿Hablamos de tu espacio?',
  texto = 'Cuéntanos dónde está, cuántos metros tiene y cómo es. Te respondemos con una propuesta concreta.',
  ubicacion = 'cta_final',
} = Astro.props
const { telefono, whatsapp } = negocio.contacto
---
<section class="seccion seccion--olivo cta">
  <div class="contenedor cta__caja" data-aparece>
    <div>
      <h2>{titulo}</h2>
      <p class="entradilla">{texto}</p>
    </div>
    <div class="botones">
      <a class="boton boton--claro" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion={ubicacion}>Pedir presupuesto</a>
      {whatsapp && <a class="boton boton--whatsapp" href={waHref(whatsapp)} target="_blank" rel="noopener">Escribir por WhatsApp</a>}
      {telefono && <a class="boton cta__tel" href={telHref(telefono)}>Llamar al {telefono}</a>}
    </div>
  </div>
</section>
<style>
  .cta__caja { display: grid; gap: 28px; align-items: end; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .cta h2 { color: var(--cal); }
  .cta__tel { color: var(--cal); border-color: rgb(247 244 238 / 0.4); }
  .cta__tel:hover { color: #fff; border-color: #fff; }
</style>
