---
// Logotipo PROVISIONAL de la línea de césped (pendiente de validar la marca).
interface Props { claro?: boolean }
const { claro = false } = Astro.props
---
<span class:list={['logo', { 'logo--claro': claro }]}>
  <svg class="logo__simbolo" viewBox="0 0 36 36" aria-hidden="true">
    <rect width="36" height="36" rx="6" fill="currentColor" />
    <path d="M9 25h18" stroke="#4cb043" stroke-width="2.4" stroke-linecap="round" />
    <path d="M18 25c0-5.5.4-9.6 3-13.5M18 25c-.5-4-2.1-7-4.9-9.2M18 25c1.1-3.1 3.3-5.4 6.3-6.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
  </svg>
  <span class="logo__texto">
    <span class="logo__marca">Universal Nautic</span>
    <span class="logo__linea">Césped artificial</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--verde); }
  .logo--claro .logo__simbolo { color: var(--verde-2); }
  .logo__simbolo { width: 38px; height: 38px; flex: none; }
  .logo__texto { display: grid; line-height: 1.1; }
  .logo__marca { font: 800 17px/1.1 var(--sans); letter-spacing: -0.01em; color: var(--verde); }
  .logo__linea { font: 600 12.5px/1.4 var(--sans); color: var(--cesped-2); }
  .logo--claro .logo__marca { color: #fff; }
  .logo--claro .logo__linea { color: #9fdc96; }
</style>
