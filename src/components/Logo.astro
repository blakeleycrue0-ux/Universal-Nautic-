---
// Logotipo oficial de Universal Nautic (versión para fondo oscuro), sin modificar.
interface Props { alto?: number }
const { alto = 34 } = Astro.props
---
<img class="logo" src="/marca/universal-nautic-logo.webp" alt="Universal Nautic" width={Math.round((alto * 780) / 304)} height={alto} style={`height:${alto}px`} />
<style>.logo { display: block; width: auto; max-width: none; }</style>
