---
interface Props { alto?: number }
const { alto = 24 } = Astro.props
---
<span class="marca" style={`--logo-ancho:${Math.round(alto*6.6)}px`}>
 <img class="marca__verde" src="/marca/universalgrass-verde.svg" width="575" height="82" alt="universalgrass."/>
 <img class="marca__blanco" src="/marca/universalgrass-blanco.svg" width="575" height="82" alt="" aria-hidden="true"/>
</span>
<style>
.marca { display:block; width:var(--logo-ancho); max-width:100%; position:relative; line-height:0; }
.marca img { width:100%; height:auto; display:block; }
.marca__blanco { position:absolute; inset:0; opacity:var(--logo-blanco,0); }
</style>
