---
import CabeceraPagina from '../../components/CabeceraPagina.astro'
import Base from '../../layouts/Base.astro'
import TarjetaProducto from '../../components/TarjetaProducto.astro'
import CtaFinal from '../../components/CtaFinal.astro'
import { productos } from '../../data/productos'
---
<Base
  titulo="Catálogo de césped artificial | Universal Grass Mallorca"
  descripcion="Modelos de césped artificial para jardines, terrazas, patios y piscinas en Mallorca: características, usos recomendados y presupuesto."
  migas={[{ nombre: 'Catálogo', url: '/catalogo/' }]}
>
  <CabeceraPagina titulo="Catálogo de césped artificial">Modelos para jardines, terrazas, patios y zonas de piscina.</CabeceraPagina>
  <section class="seccion">
    <div class="contenedor">
      {productos.length > 0 ? (
        <>
          <p class="entradilla">Modelos para cada uso. Entra en cada uno para ver sus características y pedir presupuesto.</p>
          <div class="rejilla rejilla--3 lista">{productos.map((p) => <TarjetaProducto p={p} />)}</div>
        </>
      ) : (
        <div class="vacio">
          <p class="entradilla">
            Estamos preparando las fichas de los modelos con nuestro proveedor: características técnicas, fotografías y precios. Las publicaremos aquí en cuanto estén confirmadas.
          </p>
          <div class="tarjeta">
            <h2>Mientras tanto, te recomendamos el modelo</h2>
            <p>Cuéntanos tu espacio en el formulario de presupuesto —uso, metros, superficie y fotos— y te propondremos el modelo más adecuado con sus características y precio.</p>
            <a class="boton boton--oscuro" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion="catalogo">Pedir recomendación y presupuesto</a>
          </div>
          <p>¿Aún dudando? Lee nuestra guía <a href="/como-elegir-cesped-artificial/">cómo elegir césped artificial</a>.</p>
        </div>
      )}
    </div>
  </section>
  <CtaFinal ubicacion="cta_catalogo" />
</Base>
<style>
  .lista { margin-top: 32px; }
  .vacio { display: grid; gap: 28px; max-width: 780px; }
  .vacio h2 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
</style>
