---
import Base from '../../layouts/Base.astro'
import CtaFinal from '../../components/CtaFinal.astro'
import { productos, type Producto } from '../../data/productos'

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { p } }))
}
const { p } = Astro.props as { p: Producto }
const usos: Record<string, string> = { jardin: 'Jardines', terraza: 'Terrazas', patio: 'Patios', piscina: 'Zonas de piscina' }
const filas: [string, string | null][] = [
  ['Altura de fibra', p.alturaFibraMm ? `${p.alturaFibraMm} mm` : null],
  ['Densidad', p.densidadPuntadasM2 ? `${p.densidadPuntadasM2.toLocaleString('es-ES')} puntadas/m²` : null],
  ['Peso total', p.pesoTotalGm2 ? `${p.pesoTotalGm2.toLocaleString('es-ES')} g/m²` : null],
  ['Tonos', p.tonos],
  ['Ancho de rollo', p.anchoRolloM ? p.anchoRolloM.map((a) => `${a} m`).join(' / ') : null],
  ['Drenaje', p.drenaje],
  ['Apto para mascotas', p.aptoMascotas === null ? null : p.aptoMascotas ? 'Sí' : 'No recomendado'],
  ['Garantía', p.garantia],
]
const producto = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.nombre,
  description: p.resumen,
  image: p.fotos.map((f) => new URL(f, Astro.site).href),
  ...(p.precioM2
    ? { offers: { '@type': 'Offer', priceCurrency: 'EUR', price: p.precioM2, unitText: 'm²' } }
    : {}),
}
---
<Base
  titulo={`${p.nombre} — césped artificial | Universal Grass Mallorca`}
  descripcion={p.resumen}
  imagenOg={p.fotos[0]}
  migas={[{ nombre: 'Catálogo', url: '/catalogo/' }, { nombre: p.nombre, url: `/catalogo/${p.slug}/` }]}
  jsonLd={[producto]}
>
  <section class="seccion">
    <div class="contenedor ficha">
      <div class="ficha__fotos">
        {p.fotos.map((f, i) => <img src={f} alt={`${p.nombre}, foto ${i + 1}`} loading={i ? 'lazy' : 'eager'} width="1200" height="900" />)}
      </div>
      <div>
        <h1>{p.nombre}</h1>
        <p class="entradilla">{p.resumen}</p>
        <p><strong>Recomendado para:</strong> {p.usos.map((u) => usos[u]).join(', ')}</p>
        {p.precioM2 && <p class="precio">{p.precioM2.toFixed(2).replace('.', ',')} €/m² <small>IVA incluido · solo material</small></p>}
        <table>
          <tbody>{filas.filter(([, v]) => v).map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody>
        </table>
        {p.fichaTecnicaPdf && <p><a href={p.fichaTecnicaPdf}>Descargar ficha técnica (PDF)</a></p>}
        <a class="boton boton--oscuro" href={`/presupuesto/?modelo=${encodeURIComponent(p.nombre)}`} data-track="cta_presupuesto" data-ubicacion={`ficha_${p.slug}`}>Pedir presupuesto de este modelo</a>
      </div>
    </div>
  </section>
  <CtaFinal ubicacion={`cta_ficha_${p.slug}`} />
</Base>
<style>
  .ficha { display: grid; gap: clamp(28px, 5vw, 64px); }
  @media (min-width: 960px) { .ficha { grid-template-columns: 1.1fr 0.9fr; } }
  .ficha__fotos { display: grid; gap: 12px; }
  .ficha__fotos img { width: 100%; border-radius: var(--radio); object-fit: cover; aspect-ratio: 4 / 3; }
  .precio { font: 800 2rem/1.2 var(--sans); color: var(--verde); }
  .precio small { display: block; font: 500 14px var(--sans); color: var(--texto-2); }
  table { width: 100%; border-collapse: collapse; margin: 18px 0 28px; }
  th, td { text-align: left; padding: 12px 0; border-bottom: 1px solid var(--borde); }
  th { font-weight: 600; width: 45%; }
</style>
