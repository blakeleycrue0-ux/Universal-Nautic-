---
import Base from '../../layouts/Base.astro'
import { negocio, telHref, waHref } from '../../config/negocio'
const { telefono, whatsapp, email, horario, mostrarDireccion } = negocio.contacto
---
<Base
  titulo="Contacto | Universal Nautic · Césped artificial en Mallorca"
  descripcion="Contacta con Universal Nautic para resolver dudas sobre césped artificial en Mallorca o pedir presupuesto."
  migas={[{ nombre: 'Contacto', url: '/contacto/' }]}
>
  <section class="seccion">
    <div class="contenedor contacto">
      <div>
        <h1>Contacto</h1>
        <p class="entradilla">Para pedir presupuesto, lo más rápido es el <a href="/presupuesto/">formulario de presupuesto</a>. Para cualquier otra consulta, escríbenos aquí.</p>
        <dl class="datos">
          {telefono && <div><dt>Teléfono</dt><dd><a href={telHref(telefono)}>{telefono}</a></dd></div>}
          {whatsapp && <div><dt>WhatsApp</dt><dd><a href={waHref(whatsapp)} target="_blank" rel="noopener">Escribir por WhatsApp</a></dd></div>}
          {email && <div><dt>Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>}
          {horario && <div><dt>Horario</dt><dd>{horario}</dd></div>}
          {mostrarDireccion && <div><dt>Dirección</dt><dd>{negocio.titular.domicilio}</dd></div>}
          <div><dt>Zona</dt><dd>Toda {negocio.zona.actual}</dd></div>
        </dl>
      </div>
      <form class="tarjeta form-contacto" name="contacto" method="POST" action="/contacto/gracias/" data-netlify="true" netlify-honeypot="campo-bot" data-form-contacto>
        <input type="hidden" name="form-name" value="contacto" />
        <p class="visually-hidden"><label>No rellenes este campo: <input name="campo-bot" tabindex="-1" autocomplete="off" /></label></p>
        <label for="c-nombre">Nombre</label>
        <input id="c-nombre" name="nombre" autocomplete="name" required />
        <label for="c-tel">Teléfono o email</label>
        <input id="c-tel" name="contacto" required />
        <label for="c-msg">Mensaje</label>
        <textarea id="c-msg" name="mensaje" rows="5" required></textarea>
        <label class="check"><input type="checkbox" name="acepta_privacidad" value="si" required /> <span>Acepto la <a href="/politica-de-privacidad/" target="_blank">política de privacidad</a>.</span></label>
        <button class="boton boton--principal" type="submit">Enviar mensaje</button>
      </form>
    </div>
  </section>
</Base>
<script>
  const f = document.querySelector<HTMLFormElement>('[data-form-contacto]')
  f?.addEventListener('submit', () => { try { sessionStorage.setItem('un-lead', 'contacto') } catch { /* */ } })
</script>
<style>
  .contacto { display: grid; gap: clamp(28px, 5vw, 64px); align-items: start; }
  @media (min-width: 960px) { .contacto { grid-template-columns: 1fr 1fr; } }
  .datos { display: grid; gap: 14px; margin: 28px 0 0; }
  .datos div { display: grid; gap: 2px; }
  .datos dt { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinta-2); }
  .datos dd { margin: 0; font: 450 1.3rem/1.3 var(--serif); }
  .form-contacto { display: grid; gap: 10px; }
  .form-contacto label:not(.check) { font-weight: 600; font-size: 15px; margin-top: 6px; }
  .form-contacto input:not([type='checkbox']), .form-contacto textarea { width: 100%; min-height: 50px; padding: 12px 14px; border: 1px solid #cfc6b6; border-radius: 10px; background: var(--cal); font: 400 16px/1.4 var(--sans); }
  .form-contacto .check { display: flex; gap: 10px; align-items: flex-start; margin: 8px 0 14px; font-size: 15px; }
  .form-contacto .check input { width: 20px; height: 20px; accent-color: var(--olivo); }
</style>
