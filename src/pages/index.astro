---
import Base from '../layouts/Base.astro'
import HeroFoto from '../components/HeroFoto.astro'
import Foto from '../components/Foto.astro'
import Faq from '../components/Faq.astro'
import CtaFinal from '../components/CtaFinal.astro'
import TarjetaProducto from '../components/TarjetaProducto.astro'
import { negocio, telHref } from '../config/negocio'
import { productos } from '../data/productos'
import { preguntas } from '../data/faq'
import { imagenes, publicable, type Imagen } from '../data/imagenes'

const { telefono } = negocio.contacto
type Espacio = { url: string; titulo: string; texto: string; img?: Imagen; encuadre?: string; clase: string }
const espacios: Espacio[] = [
  { url: '/cesped-artificial-para-terrazas/', titulo: 'Terrazas', texto: 'Sobre baldosa u hormigón, sin obras.', img: imagenes.terrazaCenital, encuadre: '50% 60%', clase: 'e-terrazas' },
  { url: '/cesped-artificial-para-piscinas/', titulo: 'Piscinas', texto: 'Un borde verde y limpio alrededor del agua.', img: imagenes.piscinaBorde, encuadre: '70% 70%', clase: 'e-piscinas' },
  { url: '/cesped-artificial-para-jardines/', titulo: 'Jardines', texto: 'Verde todo el año, sin riego ni siega.', clase: 'e-jardines' },
  { url: '/cesped-artificial-para-patios/', titulo: 'Patios', texto: 'Para jugar y para los perros, sin barro.', clase: 'e-patios' },
]
---
<Base
  titulo="Césped artificial en Mallorca para jardines, terrazas y piscinas | Universal Nautic"
  descripcion="Césped artificial para casas en Mallorca: jardines, terrazas, patios y zonas de piscina. Te ayudamos a elegir y te preparamos un presupuesto con tus medidas."
  cabeceraTransparente
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Universal Nautic', url: new URL('/', Astro.site).href, inLanguage: 'es' }]}
>
  <HeroFoto img={imagenes.jardinIstock} titulo="Un jardín que se disfruta." encuadre="50% 60%">
    <p>Elige el césped que encaja con tu espacio y pide presupuesto sin complicaciones.</p>
    <div class="botones">
      <a class="boton boton--blanco" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion="portada">Pedir presupuesto</a>
      {telefono && <a class="enlace-flecha" href={telHref(telefono)}>o llámanos al {telefono}</a>}
    </div>
  </HeroFoto>

  <section class="seccion">
    <div class="contenedor intro" data-aparece>
      <h2>Somos de aquí.</h2>
      <p>
        Universal Nautic trabaja en Mallorca desde {negocio.fundacion}, con sede en Santa Ponsa. Venimos del trabajo a medida con materiales de exterior y aplicamos lo mismo a tu casa: escuchar lo que necesitas, aconsejarte con franqueza y darte el presupuesto por escrito antes de que decidas nada.
      </p>
    </div>
  </section>

  <section class="seccion espacios-seccion">
    <div class="contenedor">
      <h2 class="espacios-titulo">¿Dónde lo quieres?</h2>
      <div class="espacios">
        {espacios.map((e) => {
          const conFoto = !!e.img && publicable(e.img)
          return (
            <a class:list={['espacio', e.clase, { 'espacio--foto': conFoto }]} href={e.url} data-aparece>
              {conFoto && <div class="espacio__foto"><Foto img={e.img!} sizes="(min-width: 900px) 50vw, 100vw" encuadre={e.encuadre} /></div>}
              <div class="espacio__texto">
                <h3>{e.titulo}</h3>
                <p>{e.texto}</p>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <section class="seccion seccion--gris">
    <div class="contenedor pasos-bloque">
      <h2>Cómo pedir presupuesto</h2>
      <ol class="pasos">
        <li data-aparece><span>1</span><h3>Nos cuentas tu espacio</h3><p>El municipio, los metros y, si puedes, unas fotos. Son dos minutos.</p></li>
        <li data-aparece><span>2</span><h3>Te llamamos</h3><p>Resolvemos tus dudas y vemos qué césped te conviene.</p></li>
        <li data-aparece><span>3</span><h3>Recibes la propuesta</h3><p>Por escrito, con el modelo, los metros y el precio.</p></li>
      </ol>
      <a class="boton boton--oscuro" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion="pasos">Empezar</a>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor modelos">
      <h2>Los modelos</h2>
      {productos.length > 0 ? (
        <div class="modelos__lista">{productos.slice(0, 3).map((p) => <TarjetaProducto p={p} />)}</div>
      ) : (
        <p class="entradilla">
          Estamos cerrando las fichas con nuestro proveedor: fotos, alturas, densidades y precios. Mientras tanto, te recomendamos el modelo adecuado al preparar tu presupuesto.
        </p>
      )}
    </div>
  </section>

  <section class="seccion seccion--gris">
    <div class="contenedor dudas">
      <div>
        <h2>Dudas habituales</h2>
        <a class="enlace-flecha" href="/preguntas-frecuentes/">Ver todas</a>
      </div>
      <Faq preguntas={[preguntas[0], preguntas[2], preguntas[3], preguntas[5]]} />
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  .intro { display: grid; gap: clamp(16px, 4vw, 64px); align-items: start; }
  @media (min-width: 900px) { .intro { grid-template-columns: 0.8fr 1.2fr; } }
  .intro p { font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.55; color: var(--texto-2); margin: 0; max-width: 52ch; }

  .espacios-seccion { padding-top: 0; }
  .espacios-titulo { margin-bottom: clamp(24px, 3vw, 40px); }
  .espacios { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 900px) {
    .espacios { grid-template-columns: 1.15fr 0.6fr 0.6fr; grid-template-rows: 380px 260px; grid-template-areas: 'terrazas piscinas piscinas' 'terrazas jardines patios'; }
    .e-terrazas { grid-area: terrazas; }
    .e-piscinas { grid-area: piscinas; }
    .e-jardines { grid-area: jardines; }
    .e-patios { grid-area: patios; }
  }
  .espacio { position: relative; display: flex; align-items: flex-end; min-height: 220px; overflow: hidden; background: var(--gris-50); color: var(--texto); text-decoration: none; }
  .espacio--foto { min-height: 340px; color: #fff; background: var(--oscuro); }
  .espacio__foto { position: absolute; inset: 0; }
  .espacio__foto :global(img) { transition: transform 1s var(--ease); }
  .espacio:hover .espacio__foto :global(img) { transform: scale(1.04); }
  .espacio--foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(8 14 11 / 0.7), rgb(8 14 11 / 0) 55%); }
  .espacio__texto { position: relative; z-index: 1; padding: clamp(20px, 2.6vw, 32px); }
  .espacio h3 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); margin-bottom: 0.2em; }
  .espacio p { margin: 0; opacity: 0.9; }
  .espacio:not(.espacio--foto):hover { background: #e8ebe7; color: var(--texto); }
  .espacio :global(.foto figcaption) { top: 12px; bottom: auto; }

  .pasos-bloque { display: grid; gap: 32px; justify-items: start; }
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(28px, 4vw, 56px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); width: 100%; }
  .pasos span { display: block; font: 600 clamp(3rem, 5vw, 4.5rem)/1 var(--titular); color: var(--verde); margin-bottom: 16px; }
  .pasos p { color: var(--texto-2); margin: 0; }

  .modelos { display: grid; gap: clamp(12px, 4vw, 64px); }
  @media (min-width: 900px) { .modelos { grid-template-columns: 0.8fr 1.2fr; } }
  .modelos .entradilla { max-width: 52ch; }
  .modelos__lista { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }

  .dudas { display: grid; gap: clamp(20px, 4vw, 64px); }
  @media (min-width: 900px) { .dudas { grid-template-columns: 0.8fr 1.2fr; } }
</style>
