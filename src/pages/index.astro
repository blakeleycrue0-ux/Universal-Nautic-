---
import Base from '../layouts/Base.astro'
import Foto from '../components/Foto.astro'
import FormPresupuesto from '../components/FormPresupuesto.astro'
import TarjetaProducto from '../components/TarjetaProducto.astro'
import { imagenes } from '../data/imagenes'
import { productos } from '../data/productos'
import { negocio, waHref } from '../config/negocio'
const whatsapp=negocio.contacto.whatsapp ? waHref(negocio.contacto.whatsapp) : null
---
<Base titulo="Césped artificial en Mallorca | Universal Grass" descripcion="Venta e instalación de césped artificial para jardines, terrazas, patios y piscinas en Mallorca. Solicita presupuesto con las medidas y una foto de tu espacio." cabeceraTransparente ocultarBarraMovil>
 <section class="portada" aria-labelledby="portada-titulo">
  <div class="portada__imagen"><Foto img={imagenes.villaCamino} sizes="(max-width: 700px) 300vw, 100vw" prioridad encuadre="50% 90%" encuadreMovil="35% 100%"/></div>
  <div class="portada__contenido contenedor"><h1 id="portada-titulo">Césped artificial<br />en Mallorca</h1><div class="portada__acciones"><a class="boton boton--blanco" href="#presupuesto" data-track="cta_presupuesto" data-ubicacion="portada">Pedir presupuesto <span aria-hidden="true">→</span></a></div></div>
 </section>
 <section class="servicio contenedor" aria-labelledby="servicio-titulo"><div><h2 id="servicio-titulo">Césped para tu jardín,<br />con la instalación resuelta.</h2><p>Suministramos e instalamos césped artificial en jardines, terrazas, patios y zonas de piscina. Revisamos el suelo y cómo vas a utilizarlo antes de recomendar el material.</p><a href="/instalacion/" class="enlace-flecha">Así trabajamos</a></div><div class="servicio__foto"><Foto img={imagenes.terrazaCenital} sizes="(max-width: 700px) 100vw, 45vw" encuadre="50% 60%" /></div></section>
 {productos.length > 0 && <section class="catalogo contenedor" aria-labelledby="catalogo-titulo"><div class="encabezado"><h2 id="catalogo-titulo">Nuestros céspedes</h2><a href="/catalogo/">Ver catálogo</a></div><div class="rejilla rejilla--3">{productos.map(p=><TarjetaProducto p={p}/>)}</div></section>}
 <section class="contacto contenedor" id="presupuesto" aria-labelledby="contacto-titulo"><div class="contacto__texto"><h2 id="contacto-titulo">Pide tu presupuesto</h2><p>Cuéntanos dónde está el jardín y qué superficie tiene.</p></div><FormPresupuesto />{whatsapp && <a href={whatsapp} target="_blank" rel="noopener" class="contacto__alternativa">¿Prefieres WhatsApp? Escríbenos</a>}</section>
</Base>
<style>
.portada { position:relative; height:100svh; min-height:440px; background:var(--oscuro); color:#fff; overflow:hidden; }
.portada__imagen { position:absolute; inset:-15% 0 0; }
.portada__imagen :global(img) { object-position:50% 100%; }
.portada::before { content:""; position:absolute; z-index:1; inset:0 0 auto; height:110px; pointer-events:none; background:linear-gradient(to bottom,rgba(4,20,12,.5),transparent); }
.portada::after { content:''; position:absolute; inset:0; pointer-events:none; background:linear-gradient(to top,rgba(7,19,12,.8),rgba(7,19,12,.25) 32%,transparent 62%); }
.portada__contenido { position:relative; z-index:1; height:100%; display:flex; flex-direction:column; justify-content:end; padding-top:96px; padding-bottom:max(36px,calc(env(safe-area-inset-bottom) + 28px)); }
h1 { color:#fff; font:500 clamp(2.2rem,5.3vw,5rem)/1.12 var(--sans); letter-spacing:-.025em; margin:0 0 24px; max-width:14ch; }
.portada__acciones { display:flex; align-items:center; gap:28px; }
.portada__acciones .boton { min-height:48px; min-width:0; gap:24px; padding:12px 22px; border-radius:5px; }
.portada__acciones span { font-family:system-ui,sans-serif; }
h2 { font:500 clamp(2rem,3.6vw,3.5rem)/1.12 var(--sans); letter-spacing:-.025em; }
.servicio { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:64px; padding-block:64px; }
.servicio p { max-width:44ch; color:var(--texto-2); font-size:16px; }
.servicio__foto { height:320px; }
.catalogo { padding-block:72px; }
.encabezado { display:flex; justify-content:space-between; align-items:center; gap:24px; margin-bottom:32px; }
.contacto { display:grid; grid-template-columns:.85fr 1.15fr; gap:24px 64px; padding-block:48px 64px; scroll-margin-top:0; }
.contacto__texto > p { max-width:40ch; color:var(--texto-2); font-size:16px; }
.contacto__alternativa { grid-column:2; font-size:15px; }
@media(prefers-reduced-motion:no-preference) {
 .portada__imagen { animation:abrir-jardin 700ms cubic-bezier(.2,.65,.3,1) both; transform-origin:50% 75%; }
 @keyframes abrir-jardin { from { transform:scale(1.025); } to { transform:scale(1); } }
}
@media(max-width:800px) { .servicio,.contacto { grid-template-columns:1fr; gap:20px; } .servicio { padding-block:40px; } .servicio__foto { height:250px; } .contacto { padding-top:24px; } .contacto__alternativa { grid-column:auto; margin-top:4px; } .contacto__texto h2 { margin-bottom:8px; font-size:1.7rem; } .contacto__texto p { margin:0; font-size:15px; } }
@media(max-width:600px) { h1 { font-size:clamp(2.05rem,8.4vw,2.8rem); } .portada__acciones { align-items:start; flex-direction:column; } }
@media(max-height:550px) { .portada { height:auto; min-height:100svh; } .portada__contenido { min-height:440px; } }
</style>
