---
import Base from '../layouts/Base.astro'
import Foto from '../components/Foto.astro'
import FotoPendiente from '../components/FotoPendiente.astro'
import Faq from '../components/Faq.astro'
import CtaFinal from '../components/CtaFinal.astro'
import { imagenes, publicable } from '../data/imagenes'
import { preguntas } from '../data/faq'
const espacios = [
  { nombre: 'Jardines', texto: 'Un lugar para bajar el ritmo.', url: '/cesped-artificial-para-jardines/' },
  { nombre: 'Piscinas', texto: 'El entorno también se disfruta.', url: '/cesped-artificial-para-piscinas/' },
  { nombre: 'Terrazas y patios', texto: 'Más vida al aire libre, también en casa.', url: '/cesped-artificial-para-terrazas/' },
]
---
<Base titulo="Césped artificial e instalación en Mallorca | Universal Grass" descripcion="Universal Grass, by Universal Nautic. Venta, asesoramiento e instalación de césped artificial para jardines, terrazas y piscinas en Mallorca.">
  <section class="portada">
    <div class="contenedor portada__rejilla">
      <div class="portada__texto">
        <span class="ceja">Césped artificial · Mallorca</span>
        <h1>Un jardín<br />que se <em>disfruta.</em></h1>
        <p>Transformamos jardines, terrazas y espacios exteriores con césped artificial de calidad e instalación profesional.</p>
        <div class="botones"><a href="/presupuesto/" class="boton boton--oscuro" data-track="cta_presupuesto" data-ubicacion="portada">Pedir presupuesto <span aria-hidden="true"> ↗</span></a><a href="/visualiza-tu-jardin/" class="enlace-flecha">Visualizar mi jardín</a></div>
        <span class="portada__firma">Tu espacio. Tu manera de vivirlo.</span>
      </div>
      <div class="portada__foto">
        {publicable(imagenes.villaCamino) ? <Foto img={imagenes.villaCamino} sizes="(min-width: 900px) 55vw, 100vw" prioridad /> : <FotoPendiente texto="Un jardín mediterráneo para disfrutar" formato="vertical" />}
      </div>
    </div>
    <div class="contenedor servicios"><span>Venta de césped artificial</span><span>Asesoramiento para tu espacio</span><span>Instalación profesional</span></div>
  </section>
  <section class="seccion">
    <div class="contenedor introduccion"><span class="ceja">El exterior, a tu medida</span><h2>Más tiempo fuera.<br />Más espacio para ti.</h2><div><p class="entradilla">Una comida que se alarga. Los pies descalzos. Un rincón donde parar. Cada espacio tiene una forma distinta de disfrutarse.</p><p>Te ayudamos a elegir el césped y a planificar la instalación teniendo en cuenta el suelo, el uso y los detalles de tu casa.</p><a class="enlace-flecha" href="/instalacion/">Conoce cómo lo hacemos ↗</a></div></div>
  </section>
  <section class="seccion seccion--gris">
    <div class="contenedor"><div class="titulo-fila"><div><span class="ceja">Aplicaciones</span><h2>Tu próximo lugar favorito.</h2></div><a href="/aplicaciones/" class="enlace-flecha">Explorar espacios ↗</a></div>
      <div class="espacios">{espacios.map((e, i) => <article><FotoPendiente texto={e.nombre} /><div class="espacio-texto"><span class="numero">0{i + 1}</span><div><h3><a href={e.url}>{e.nombre}</a></h3><p>{e.texto}</p></div><a href={e.url} aria-label={`Ver césped para ${e.nombre.toLowerCase()}`} class="flecha">↗</a></div></article>)}</div>
    </div>
  </section>
  <section class="seccion"><div class="contenedor visualiza"><div class="visualiza__indice"><span class="ceja">Otra forma de imaginarlo</span><span aria-hidden="true" class="visualiza__numero">01 / IA</span></div><div><h2>Antes de decidir,<br /><em>imagina el cambio.</em></h2><p class="entradilla">Estamos preparando una herramienta para visualizar tu jardín con césped artificial a partir de una fotografía de tu espacio.</p><p class="estado">Simulador en preparación · aún no disponible</p><a href="/visualiza-tu-jardin/" class="boton boton--linea">Conocer el simulador ↗</a></div></div></section>
  <section class="seccion seccion--oscura"><div class="contenedor proceso"><div><span class="ceja">De la idea al jardín</span><h2>Nos ocupamos<br />del camino.</h2><a href="/instalacion/" class="enlace-flecha">Así es la instalación ↗</a></div><ol>{[['Te escuchamos', 'Nos cuentas dónde está tu espacio, cómo lo usas y qué te gustaría cambiar.'], ['Valoramos tu proyecto', 'Revisamos las medidas y el estado del suelo para preparar una propuesta por escrito.'], ['Preparamos e instalamos', 'Planificamos la base, la colocación y los remates según las necesidades del espacio.']].map(([titulo,texto],i)=><li><span>0{i+1}</span><div><h3>{titulo}</h3><p>{texto}</p></div></li>)}</ol></div></section>
  <section class="seccion"><div class="contenedor dudas"><div><span class="ceja">Elegir con tranquilidad</span><h2>Las cosas claras,<br />desde el principio.</h2><a href="/preguntas-frecuentes/" class="enlace-flecha">Todas las preguntas ↗</a></div><Faq preguntas={[preguntas[0], preguntas[1], preguntas[3], preguntas[4]]} /></div></section>
  <CtaFinal titulo="Tu jardín empieza con una conversación." texto="Cuéntanos qué tienes en mente. Te ayudamos a dar el siguiente paso." />
</Base>
<style>
.portada { padding-top: 32px; }
.portada__rejilla { display: grid; grid-template-columns: 1fr 1.1fr; min-height: 620px; gap: 48px; }
.portada__texto { align-self: center; padding-block: 36px; }
h1 { font-size: clamp(3rem, 5.7vw, 6rem); letter-spacing: -.055em; line-height: 1.02; margin-bottom: 28px; }
em { font-style: normal; color: #64815b; }
.portada__texto > p { max-width: 38ch; color: var(--texto-2); margin-bottom: 32px; }
.portada__firma { display: block; font-size: 12px; margin-top: 52px; color: var(--texto-2); }
.portada__foto { min-width: 0; }
.servicios { display: flex; flex-wrap: wrap; gap: 16px 48px; padding-block: 28px; border-bottom: 1px solid var(--borde); font-size: 12px; }
.servicios span::before { content: '—'; margin-right: 12px; color: #64815b; }
.introduccion { display: grid; grid-template-columns: 1fr 1fr; gap: 0 100px; }
.introduccion > .ceja { grid-column: 1 / -1; }
.introduccion p:not(.entradilla) { color: var(--texto-2); }
.titulo-fila { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 40px; }
.titulo-fila h2 { margin: 0; }
.espacios { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.espacio-texto { display: flex; align-items: start; gap: 16px; padding-top: 24px; }
.espacio-texto .numero { padding-top: 6px; }
.espacio-texto h3 a { color: inherit; text-decoration: none; }
.espacio-texto p { font-size: 14px; color: var(--texto-2); }
.flecha { margin-left: auto; font-size: 24px; text-decoration: none; }
.visualiza { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
.visualiza__indice { display: flex; flex-direction: column; justify-content: space-between; border-left: 1px solid var(--borde); padding-left: 28px; }
.visualiza__numero { font: 400 clamp(3rem, 7vw, 7rem)/1 var(--titular); letter-spacing: -.06em; color: #b2bba8; }
.estado { color: var(--texto-2); font-size: 13px; margin: 24px 0; }
.proceso, .dudas { display: grid; grid-template-columns: 1fr 1.1fr; gap: 80px; }
.proceso ol { list-style: none; padding: 0; margin: 0; }
.proceso li { display: grid; grid-template-columns: 40px 1fr; gap: 20px; padding-block: 28px; border-top: 1px solid #ffffff35; }
.proceso li > span { font-size: 12px; color: #bdcdb5; }
.proceso li p { color: #d0d9d0; margin-bottom: 0; }
@media(max-width:1000px) { .portada__rejilla { gap: 24px; } .portada__texto .botones { align-items: start; flex-direction: column; } .introduccion, .visualiza, .proceso, .dudas { gap: 32px; } }
@media(max-width:700px) { .portada { padding-top: 8px; } .portada__rejilla, .introduccion, .visualiza, .proceso, .dudas { grid-template-columns: 1fr; } .portada__rejilla { min-height: 0; gap: 16px; } .portada__firma { margin-top: 28px; } .portada__texto { padding-block: 28px; } .espacios { grid-template-columns: 1fr; gap: 32px; } .titulo-fila { flex-direction: column; align-items: start; } .visualiza__numero { margin-top: 24px; } .servicios { gap: 10px; flex-direction: column; } }
</style>
