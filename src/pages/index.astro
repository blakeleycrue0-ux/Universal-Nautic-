---
import Base from '../layouts/Base.astro'
import Foto from '../components/Foto.astro'
import FormPresupuesto from '../components/FormPresupuesto.astro'
import TarjetaProducto from '../components/TarjetaProducto.astro'
import { imagenes } from '../data/imagenes'
import { productos } from '../data/productos'
import { negocio, waHref } from '../config/negocio'
const whatsapp=negocio.contacto.whatsapp ? waHref(negocio.contacto.whatsapp) : null
---
<Base titulo="Césped artificial en Mallorca | Universal Grass" descripcion="Venta e instalación de césped artificial para jardines, terrazas, patios y piscinas en Mallorca. Solicita presupuesto con las medidas y una foto de tu espacio." cabeceraTransparente ocultarBarraMovil>
 <section class="portada" aria-labelledby="portada-titulo">
  <div class="portada__imagen"><Foto img={imagenes.villaCamino} sizes="(max-width: 700px) 300vw, 100vw" prioridad encuadre="50% 62%" encuadreMovil="43% 63%"/></div>
  <div class="portada__contenido contenedor"><h1 id="portada-titulo">Césped artificial<br />en Mallorca</h1><div class="portada__acciones"><a class="boton boton--blanco" href="#presupuesto" data-track="cta_presupuesto" data-ubicacion="portada">Pedir presupuesto</a><a class="portada__simulador" href="#simulador">Ver el simulador</a></div></div>
 </section>
 <section class="simulador" id="simulador" aria-labelledby="simulador-titulo"><div class="contenedor simulador__interior"><div><h2 id="simulador-titulo">¿Cómo quedaría<br />en tu jardín?</h2><p>La herramienta de simulación está pendiente. Todavía no permite subir una foto ni generar una vista de tu jardín.</p><p>Por ahora puedes enviarnos una foto para que valoremos el suelo, las medidas y la instalación.</p><a href="#presupuesto" class="enlace-flecha">Consultar con una foto</a></div><div class="simulador__estado"><span>Simulador no disponible</span><p>El antes y después se mostrará aquí cuando dispongamos de una comparación real del mismo espacio.</p></div></div></section>
 {productos.length > 0 && <section class="catalogo contenedor" aria-labelledby="catalogo-titulo"><div class="encabezado"><h2 id="catalogo-titulo">Nuestros céspedes</h2><a href="/catalogo/">Ver catálogo</a></div><div class="rejilla rejilla--3">{productos.map(p=><TarjetaProducto p={p}/>)}</div></section>}
 <section class="contacto contenedor" id="presupuesto" aria-labelledby="contacto-titulo"><div class="contacto__texto"><h2 id="contacto-titulo">Pide tu presupuesto.</h2><p>Indica dónde está el espacio y cuántos metros tiene. Si puedes, añade una foto. Te contactaremos para concretar el material y la instalación.</p>{whatsapp && <a class="contacto__whatsapp" href={whatsapp} target="_blank" rel="noopener">WhatsApp · 630 45 56 07</a>}<p class="contacto__servicio">Suministro de césped e instalación en Mallorca.<br />Jardines, terrazas, patios y zonas de piscina.</p><a href="/instalacion/" class="contacto__proceso">Cómo trabajamos</a></div><FormPresupuesto /></section>
</Base>
<style>
.portada { position:relative; height:100svh; min-height:540px; background:#173a2c; color:#fff; overflow:hidden; }
.portada__imagen { position:absolute; inset:0; }
.portada::after { content:''; position:absolute; inset:0; pointer-events:none; background:linear-gradient(to top,rgba(7,19,12,.8),rgba(7,19,12,.25) 32%,transparent 62%); }
.portada__contenido { position:relative; z-index:1; height:100%; display:flex; flex-direction:column; justify-content:end; padding-top:120px; padding-bottom:max(48px,calc(env(safe-area-inset-bottom) + 32px)); }
h1 { color:#fff; font:400 clamp(3rem,6.5vw,6.5rem)/1.03 var(--titular); letter-spacing:-.045em; margin:0 0 30px; max-width:14ch; }
.portada__acciones { display:flex; align-items:center; gap:28px; }
.portada__simulador { color:#fff; font-size:15px; text-underline-offset:5px; padding-block:14px; }
.portada__simulador:hover { color:#e2edda; }
h2 { font:400 clamp(2rem,3.6vw,3.5rem)/1.1 var(--titular); letter-spacing:-.035em; }
.simulador { background:#efeee5; padding-block:80px; scroll-margin-top:100px; }
.simulador__interior { display:grid; grid-template-columns:1fr 1.15fr; gap:80px; align-items:center; }
.simulador__interior > div:first-child > p { max-width:42ch; color:var(--texto-2); font-size:16px; }
.simulador__estado { border-block:1px solid #bac3b2; padding:48px 0; }
.simulador__estado span { font-size:15px; font-weight:600; }
.simulador__estado p { max-width:38ch; margin:16px 0 0; color:var(--texto-2); font-size:15px; }
.catalogo { padding-block:72px; }
.encabezado { display:flex; justify-content:space-between; align-items:center; gap:24px; margin-bottom:32px; }
.contacto { display:grid; grid-template-columns:.85fr 1.15fr; gap:80px; padding-block:80px; scroll-margin-top:100px; }
.contacto__texto > p { max-width:36ch; color:var(--texto-2); font-size:16px; }
.contacto__whatsapp { display:inline-block; font-size:15px; margin-block:8px 28px; }
.contacto__texto .contacto__servicio { font-size:14px; line-height:1.7; }
.contacto__proceso { font-size:14px; }
@media(prefers-reduced-motion:no-preference) {
 .portada__imagen { animation:abrir-jardin 850ms cubic-bezier(.2,.65,.3,1) both; transform-origin:50% 75%; }
 .portada h1 { animation:levantar-titulo 650ms ease-out both; }
 @keyframes abrir-jardin { from { transform:scale(1.065) translateY(8px); } to { transform:scale(1) translateY(0); } }
 @keyframes levantar-titulo { from { transform:translateY(10px); } to { transform:translateY(0); } }
}
@media(max-width:800px) { .simulador__interior,.contacto { grid-template-columns:1fr; gap:32px; } .simulador,.contacto { padding-block:48px; } .simulador__estado { padding-block:24px; } }
@media(max-width:600px) { .portada__contenido { padding-bottom:max(42px,calc(env(safe-area-inset-bottom) + 32px)); } h1 { font-size:clamp(2.7rem,11vw,3.8rem); margin-bottom:24px; } .portada__acciones { align-items:start; flex-direction:column; gap:4px; } .portada__acciones .boton { min-width:190px; } }
@media(max-height:600px) and (min-width:600px) { .portada { min-height:460px; } h1 { font-size:3rem; } .portada__contenido { padding-bottom:28px; } }
</style>
