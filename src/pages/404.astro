---
import Base from '../layouts/Base.astro'
---
<Base titulo="Página no encontrada | Universal Nautic" descripcion="La página que buscas no existe." noindex>
  <section class="seccion">
    <div class="contenedor" style="max-width: 680px">
      <h1>Esta página no existe</h1>
      <p class="entradilla">Puede que el enlace sea antiguo o que la dirección esté mal escrita.</p>
      <div class="botones">
        <a class="boton boton--principal" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion="404">Pedir presupuesto</a>
        <a class="boton boton--secundario" href="/">Ir al inicio</a>
      </div>
    </div>
  </section>
</Base>
