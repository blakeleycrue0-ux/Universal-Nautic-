---
import Base from '../../layouts/Base.astro'
import FormPresupuesto from '../../components/FormPresupuesto.astro'
import { negocio, waHref } from '../../config/negocio'
---
<Base titulo="Pedir presupuesto de césped artificial | Universal Grass Mallorca" descripcion="Solicita presupuesto con la localidad, los metros aproximados y tus datos de contacto. Puedes añadir una fotografía del jardín." ocultarBarraMovil>
<section class="presupuesto contenedor"><div><h1>Pide tu presupuesto</h1><p>Cuéntanos dónde está el jardín y qué superficie tiene.</p></div><FormPresupuesto />{negocio.contacto.whatsapp && <a class="alternativa" href={waHref(negocio.contacto.whatsapp)} target="_blank" rel="noopener">¿Prefieres WhatsApp? Escríbenos</a>}</section>
</Base>
<style>
.presupuesto { display:grid; grid-template-columns:.85fr 1.15fr; gap:24px 64px; padding-block:32px 64px; }
h1 { font-size:clamp(1.7rem,3vw,2.8rem); margin-bottom:8px; } p { font-size:15px; color:var(--texto-2); }
.alternativa { grid-column:2; font-size:15px; }
@media(max-width:800px) { .presupuesto { grid-template-columns:1fr; gap:20px; padding-top:24px; } .alternativa { grid-column:auto; } }
</style>
