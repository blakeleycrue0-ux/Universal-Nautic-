---
import Base from '../../layouts/Base.astro'
import CabeceraPagina from '../../components/CabeceraPagina.astro'
import CtaFinal from '../../components/CtaFinal.astro'
---
<Base titulo="Visualiza tu jardín | Universal Grass" descripcion="Conoce el futuro simulador de Universal Grass para visualizar tu jardín con césped artificial. Herramienta en preparación, todavía no disponible." migas={[{nombre:'Visualiza tu jardín',url:'/visualiza-tu-jardin/'}]}>
<CabeceraPagina titulo="Imagina lo que puede ser.">Una nueva manera de dar el primer paso hacia tu jardín.</CabeceraPagina>
<section class="seccion"><div class="contenedor simulador"><div><span class="ceja">Visualiza tu jardín · En preparación</span><h2>Tu espacio.<br />Una nueva perspectiva.</h2><p class="entradilla">Estamos preparando una herramienta de edición con IA para explorar cómo podría quedar tu jardín, terraza o patio con césped artificial.</p><p>El simulador todavía no está disponible. Cuando esté activo, podrás subir una fotografía, comparar el antes y el después y adjuntar la visualización a tu solicitud de presupuesto.</p><p>Las imágenes serán orientativas: no sustituirán una muestra física ni representarán exactamente las prestaciones de un producto.</p><a class="boton boton--oscuro" href="/presupuesto/" data-track="cta_presupuesto" data-ubicacion="simulador_pendiente">Pedir asesoramiento ahora ↗</a></div><aside><span class="ceja">Así será el recorrido</span><ol><li><span>01</span><div><h3>Una foto de tu espacio</h3><p>El punto de partida será tu jardín real.</p></div></li><li><span>02</span><div><h3>Explora el cambio</h3><p>Una edición orientativa con césped artificial y comparación antes/después.</p></div></li><li><span>03</span><div><h3>Cuéntanos tu proyecto</h3><p>Podrás incluir el resultado al solicitar presupuesto.</p></div></li></ol><p class="nota">Aún no se pueden subir fotografías ni generar imágenes desde esta página.</p></aside></div></section>
<CtaFinal titulo="Mientras tanto, podemos hablar de tu jardín." ubicacion="visualiza" />
</Base>
<style>.simulador { display:grid; grid-template-columns:1.1fr 1fr; gap:80px; } .simulador > div > p:not(.entradilla) { max-width:52ch; color:var(--texto-2); } aside { background:var(--gris-50); padding:clamp(24px,4vw,48px); align-self:start; } ol { list-style:none; margin:0; padding:0; } li { display:grid; grid-template-columns:28px 1fr; gap:16px; padding-block:24px; border-top:1px solid var(--borde); } li > span { font-size:12px; } li p,.nota { font-size:14px; color:var(--texto-2); } .nota { margin:16px 0 0; } @media(max-width:800px) { .simulador { grid-template-columns:1fr; gap:40px; } }</style>
